  "tokenColors": [
    {
      "scope": "source",
      "settings": {
        "foreground": "#F4F7F8"
      }
    },
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6E7A7E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.template",
        "string.regexp",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#0FA898"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#C9A227"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.logical",
        "storage.type",
        "storage.modifier",
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E0554C"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#0FA898"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#C9A227"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#B9C4C7"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#8D979A"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#E0554C"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#E0554C",
        "fontStyle": "underline"
      }
    },
    {
      "scope": [
        "markup.heading"
      ],
      "settings": {
        "foreground": "#C9A227",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#8D979A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "markup.inserted.git_gutter"
      ],
      "settings": {
        "foreground": "#0FA898"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#E0554C"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#C9A227"
      }
    },
    {
      "scope": [
        "meta.diff.header"
      ],
      "settings": {
        "foreground": "#8D979A",
        "fontStyle": "bold"
      }
    }
  ]
}
