# Non-secret configuration only — copy to .env (mode 0600).
# The bearer token is NOT stored here; it lives in the macOS Keychain
# (com.kitsunekits.reminders-mcp). See SECURITY.md.

# Force ALL tool calls to this account (leave blank to allow all accounts).
# For an Apple Business managed account, this is usually the work email
# address — confirm the exact name with the list_accounts tool.
DEFAULT_ACCOUNT=

PORT=3000
